{
  "name": "@eatsjobs/media-mock",
  "version": "1.3.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eatsjobs/media-mock.git"
  },
  "keywords": [
    "media",
    "mediaDevices",
    "getUserMedia",
    "mock",
    "browser",
    "testing",
    "playwright",
    "video",
    "mocking",
    "webcam",
    "automated-testing",
    "mock-media",
    "ui-testing"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "umd:main": "./dist/media-mock.umd.min.js",
  "unpkg": "./dist/media-mock.umd.min.js",
  "jsdelivr": "./dist/media-mock.umd.min.js",
  "author": "@eatsjobs Pasquale Mangialavori",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/media-mock.cjs",
  "module": "./dist/media-mock.js",
  "types": "./dist/main.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/media-mock.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/media-mock.cjs"
      }
    }
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest --run",
    "test-coverage": "vitest --run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && pnpm exec changeset publish --provenance",
    "check-types": "pnpm exec attw $(pnpm pack | tail -1) --profile=node16"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "~0.18.2",
    "@arethetypeswrong/cli": "~0.18.2",
    "@biomejs/biome": "2.4.16",
    "@changesets/cli": "^2.29.7",
    "@codecov/vite-plugin": "^2.0.1",
    "@types/node": "^25.9.1",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "playwright": "^1.60.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=16.0.0"
  }
}
